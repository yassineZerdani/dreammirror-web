# =============================================================
# DreamMirror Marketing Site — environment variables
# =============================================================
# All NEXT_PUBLIC_* variables are inlined into the client bundle
# at build time. Update them, then redeploy.

# Public site URL (no trailing slash). Used for canonical, OG, sitemap.
# Production: https://YOUR_MARKETING_HOST.example.com
NEXT_PUBLIC_SITE_URL=https://YOUR_MARKETING_HOST.example.com

# Public URL where the Android APK is downloaded from.
# Default: a same-origin proxy (/download/dreammirror.apk) that streams the
# latest GitHub Release asset with the correct Content-Type. This avoids the
# `dreammirror.apk.html` filename bug on Android browsers (the `download`
# attribute is ignored on cross-origin URLs, so the redirect HTML gets saved).
# Override only if you self-host the APK directly (e.g. /downloads/dreammirror.apk).
NEXT_PUBLIC_APK_URL=/download/dreammirror.apk

# Server-only: where the proxy fetches the APK from. Defaults to the latest
# GitHub Release asset named `dreammirror.apk`.
# APK_UPSTREAM_URL=https://github.com/yassineZerdani/dreammirror-web/releases/latest/download/dreammirror.apk

# App version shown on the download page. Should match app.json version.
NEXT_PUBLIC_APP_VERSION=1.0.0

# Optional: APK file size shown on the download page (e.g. "42 MB").
NEXT_PUBLIC_APK_SIZE=

# ---- iOS (.ipa) -------------------------------------------------------
# Where the iOS .ipa can be downloaded. iOS distribution is direct-install
# only — users will need a sideloading tool (AltStore, Sideloadly, etc.).
# Leave empty to hide the iOS download UI and show the "coming later" card.
# When ready, set one of:
#   1) /downloads/dreammirror.ipa           (drop the .ipa into public/downloads/)
#   2) https://github.com/<org>/<repo>/releases/latest/download/dreammirror.ipa
#   3) https://cdn.example.com/dreammirror-1.0.0.ipa
NEXT_PUBLIC_IPA_URL=

# Optional override; falls back to NEXT_PUBLIC_APP_VERSION if empty.
NEXT_PUBLIC_IPA_VERSION=

# Optional: IPA file size shown on the download page (e.g. "48 MB").
NEXT_PUBLIC_IPA_SIZE=

# Support email used in footer and trust copy.
NEXT_PUBLIC_SUPPORT_EMAIL=support@dreammirror.app

# ---- Blog comments (Giscus / GitHub Discussions) -----------------------
# Optional. When all four IDs are set, each journal article shows a threaded
# discussion at the bottom. Generate values at https://giscus.app (needs a
# public GitHub repo with Discussions enabled and the giscus GitHub App
# installed on that repo).
# NEXT_PUBLIC_GISCUS_REPO=owner/dreammirror-web
# NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDO...
# NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDO...
# Optional theme (default: transparent_dark). See giscus “theme” options.
# NEXT_PUBLIC_GISCUS_THEME=transparent_dark

# ---- Docker (remote server) --------------------------------------------
# Copy this file to `.env` next to docker-compose.yml. Compose reads `.env`
# for ${NEXT_PUBLIC_*} substitution at **build** time, then:
#   docker compose up -d --build
# Optional: WEB_PORT=8080 to publish the container on another host port.
# Leave NEXT_PUBLIC_IPA_URL empty until an iOS build is published ("coming later").
