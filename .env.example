# =============================================================
# DreamMirror Marketing Site — environment variables
# =============================================================
# All NEXT_PUBLIC_* variables are inlined into the client bundle
# at build time. Update them, then redeploy.

# Public site URL (no trailing slash). Used for canonical, OG, sitemap.
NEXT_PUBLIC_SITE_URL=https://dreammirror.app

# Where the Android APK can be downloaded.
# Easiest options, in order of preference:
#   1) /downloads/dreammirror.apk           (drop the .apk into public/downloads/)
#   2) https://github.com/<org>/<repo>/releases/latest/download/dreammirror.apk
#   3) https://cdn.example.com/dreammirror-1.0.0.apk
NEXT_PUBLIC_APK_URL=/downloads/dreammirror.apk

# App version shown on the download page. Should match app.json version.
NEXT_PUBLIC_APP_VERSION=1.0.0

# Optional: APK file size shown on the download page (e.g. "42 MB").
NEXT_PUBLIC_APK_SIZE=

# ---- iOS (.ipa) -------------------------------------------------------
# Where the iOS .ipa can be downloaded. iOS distribution is direct-install
# only — users will need a sideloading tool (AltStore, Sideloadly, etc.).
# Leave empty to hide the iOS download UI and show the "coming later" card.
#   1) /downloads/dreammirror.ipa           (drop the .ipa into public/downloads/)
#   2) https://github.com/<org>/<repo>/releases/latest/download/dreammirror.ipa
#   3) https://cdn.example.com/dreammirror-1.0.0.ipa
NEXT_PUBLIC_IPA_URL=/downloads/dreammirror.ipa

# Optional override; falls back to NEXT_PUBLIC_APP_VERSION if empty.
NEXT_PUBLIC_IPA_VERSION=

# Optional: IPA file size shown on the download page (e.g. "48 MB").
NEXT_PUBLIC_IPA_SIZE=

# Support email used in footer and trust copy.
NEXT_PUBLIC_SUPPORT_EMAIL=support@dreammirror.app

# ---- Docker (remote server) --------------------------------------------
# Copy this file to .env in the same folder as docker-compose.yml. Compose
# reads .env for ${NEXT_PUBLIC_*} substitution at build time. Then:
#   docker compose up -d --build
# Optional: WEB_PORT=8080 to publish the container on another host port.
