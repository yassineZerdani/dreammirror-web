# =============================================================================
# Production template — copy to `.env` next to docker-compose.yml for deploy.
# NEXT_PUBLIC_* are baked into the image at build time; rebuild after changes.
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://YOUR_MARKETING_HOST.example.com
NEXT_PUBLIC_APK_URL=/download/dreammirror.apk
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APK_SIZE=
NEXT_PUBLIC_IPA_URL=
NEXT_PUBLIC_IPA_VERSION=
NEXT_PUBLIC_IPA_SIZE=
NEXT_PUBLIC_SUPPORT_EMAIL=support@dreammirror.app

# Optional: override APK proxy upstream (defaults to GitHub Releases latest)
# APK_UPSTREAM_URL=https://github.com/yassineZerdani/dreammirror-web/releases/latest/download/dreammirror.apk

# Optional: host port for compose
# WEB_PORT=3000
